        "when": "url_cross_session_reuse * 100 >= eligible * 20",
        "prompt_contribution_diagnostic_authorized": true,
        "otherwise": false,
        "scope": "A separately preregistered diagnostic may test whether prompt specificity, rather than URL recurrence, is the dominant reason exact operation reuse is low. It may not reclassify PRIVATE304, alter the frozen operation identity, or authorize replay/Production changes."
      }
    },
    {
      "when": "eligible >= 100 AND exact_cross_session_reuse * 100 >= eligible * 5 AND exact_cross_session_reuse * 100 < eligible * 20",
      "verdict": "WEAK_FULL_SWECHAT_EXACT_OVERLAP_AUTHORIZE_REPLAY_PREREG_ONLY",
      "authoritative_browser_replay_authorized": true,
      "prompt_contribution_diagnostic_authorized": false,
      "meaning": "Authorize only creation of a separate authoritative replay preregistration. No repeated operation payload may be inspected for replay selection before that preregistration is frozen."
    },
    {
      "when": "eligible >= 100 AND exact_cross_session_reuse * 100 >= eligible * 20",
      "verdict": "STRONG_FULL_SWECHAT_EXACT_OVERLAP_AUTHORIZE_REPLAY_PREREG_ONLY",
      "authoritative_browser_replay_authorized": true,
      "prompt_contribution_diagnostic_authorized": false,
      "meaning": "Authorize only creation of a separate authoritative replay preregistration. Strong overlap alone does not establish material savings, observer independence, sequentiality, or SeenRelay value."
    }
