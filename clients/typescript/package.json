{
  "name": "seenrelay",
  "version": "0.2.5",
  "description": "Avoid redundant expensive validation with local-first SeenRelay clients.",
  "type": "module",
  "main": "./dist/seenrelay.js",
  "types": "./dist/seenrelay.d.ts",
  "exports": {
    ".": {
      "types": "./dist/seenrelay.d.ts",
      "import": "./dist/seenrelay.js"
    },
    "./shadow-proof": {
      "types": "./dist/shadow-proof.d.ts",
      "import": "./dist/shadow-proof.js"
    },
    "./zero-state": {
      "types": "./dist/zero-state.d.ts",
      "import": "./dist/zero-state.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./mcp-auto": {
      "types": "./dist/mcp-auto.d.ts",
      "import": "./dist/mcp-auto.js"
    },
    "./firecrawl": {
      "types": "./dist/firecrawl.d.ts",
      "import": "./dist/firecrawl.js"
    },
    "./firecrawl-shadow": {
      "types": "./dist/firecrawl-shadow.d.ts",
      "import": "./dist/firecrawl-shadow.js"
    },
    "./firecrawl-sdk-shadow": {
      "types": "./dist/firecrawl-sdk-shadow.d.ts",
      "import": "./dist/firecrawl-sdk-shadow.js"
    },
    "./economics": {
      "types": "./dist/economics.d.ts",
      "import": "./dist/economics.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovladon/seenrelay.git",
    "directory": "clients/typescript"
  },
  "homepage": "https://seenrelay.com/clients",
  "bugs": {
    "url": "https://github.com/ovladon/seenrelay/issues"
  },
  "keywords": [
    "ai-agents",
    "validation",
    "freshness",
    "cache",
    "mcp"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
