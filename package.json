{
  "name": "seenrelay",
  "version": "0.3.0",
  "private": true,
  "description": "Cooperative fact-freshness signals for AI agents.",
  "type": "module",
  "scripts": {
    "public:sync": "node scripts/sync-public-surfaces.mjs --write",
    "public:sync:check": "node scripts/sync-public-surfaces.mjs --enforce-freshness",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "typecheck:full": "tsc -p tsconfig.json --noEmit",
    "guardrails": "node scripts/guardrails.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "test:structural": "node --test tests/*.test.mjs",
    "test:runtime": "tsx --test tests/*.test.ts",
    "test": "npm run test:structural && npm run test:runtime",
    "check": "npm run public:sync:check && npm run typecheck:core && npm run typecheck:full && npm run guardrails && npm run audit:all && npm test",
    "benchmark:evaluate": "node scripts/evaluate-hostile-benchmark.mjs",
    "benchmark:natural-set": "node scripts/evaluate-natural-workload-set.mjs",
    "economics:surface": "node scripts/model-break-even-surface.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@neondatabase/serverless": "^1.0.2",
    "hono": "^4.9.8",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "mcpName": "io.github.ovladon/seenrelay"
}
